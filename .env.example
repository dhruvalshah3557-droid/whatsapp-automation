# n8n connection
N8N_URL=https://dhruval.n8n-hub.site
N8N_API_KEY=your_n8n_api_key

# Meta verification token (must match the token you set in each Meta app webhook config)
META_VERIFY_TOKEN=change_me_verify_token

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=change_me_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id

# Instagram Messenger (Instagram Graph API token with instagram_manage_messages permission)
INSTAGRAM_ACCESS_TOKEN=change_me_instagram_token

# Facebook Messenger (Page access token with pages_messaging permission)
FACEBOOK_PAGE_ACCESS_TOKEN=change_me_facebook_page_token
