# Server port (cPanel sets PORT automatically, usually leave this unset)
# PORT=3000

# Meta verification token (must match the token set in each Meta app webhook config)
VERIFY_TOKEN=change_me_verify_token

# Instagram Messenger (Instagram Graph API token with instagram_manage_messages permission)
INSTAGRAM_ACCESS_TOKEN=change_me_instagram_token

# Facebook Messenger (Page access token with pages_messaging permission)
FACEBOOK_PAGE_ACCESS_TOKEN=change_me_facebook_page_token

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=change_me_whatsapp_token

# LINE Official Account (Channel access token)
LINE_CHANNEL_ACCESS_TOKEN=change_me_line_token

# TikTok Messenger (TikTok Messaging API user access token)
TIKTOK_ACCESS_TOKEN=change_me_tiktok_token

# WeChat Official Account (server Token used for the SHA1 challenge)
WECHAT_TOKEN=change_me_wechat_token

# Live API (used by the messaging app: /api/health, /api/events, /api/send)
# Optional: require Authorization: Bearer <API_KEY> on /api/events and /api/send
# API_KEY=change_me_api_key

# Needed by POST /api/send for WhatsApp (used as the messages endpoint id)
# WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id

# Needed by POST /api/send for Instagram (the Instagram Business account id)
# INSTAGRAM_SENDER_ID=change_me_instagram_sender_id

# Needed by POST /api/track for FedEx package tracking
# FEDEX_API_KEY=change_me_fedex_key
# FEDEX_API_SECRET=change_me_fedex_secret

# Needed by POST /api/track for DHL package tracking
# DHL_API_KEY=change_me_dhl_api_key

# Optional: override the default auto-reply texts
# INSTAGRAM_REPLY_TEXT=Thanks for your Instagram message!
# FACEBOOK_REPLY_TEXT=Thanks for your Facebook message!
# WHATSAPP_REPLY_TEXT=Thanks for your message! This is an automated reply from your WhatsApp bot.
# LINE_REPLY_TEXT=Thanks for your LINE message!
# TIKTOK_REPLY_TEXT=Thanks for your TikTok message!
# WECHAT_REPLY_TEXT=Thanks for your WeChat message!
