# Secrets - never commit real credentials
.env
*.env.local
server/.env

# Dependencies
node_modules/

# Logs
*.log

# Webhook event store (runtime data)
server/events.json
server/test/tmp-events.json

# Colourdiam diamond inventory cache (regenerated by site-sync)
server/inventory.json
server/inventory.json.tmp
server/test/tmp-inventory.json

# FTP media config saved from the app (contains FTP credentials)
server/media-config.json
server/test/tmp-media-config.json

# OS files
.DS_Store

# n8n exports with credentials
*.n8n
