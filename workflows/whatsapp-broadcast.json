    {
      "parameters": {
        "jsCode": "const contacts = [\n  { to: 'RECIPIENT_1_PHONE_NUMBER', message: 'Hello! This is a broadcast message from your WhatsApp bot.' },\n  { to: 'RECIPIENT_2_PHONE_NUMBER', message: 'Hello! This is a broadcast message from your WhatsApp bot.' }\n];\nreturn contacts;"
