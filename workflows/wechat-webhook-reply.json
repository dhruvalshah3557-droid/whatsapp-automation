      "webhookId": "61c7b4bd-b8c7-4716-bd54-fc0bebc89026"
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.body;\nfunction get(tag) {\n  const m = xml.match(new RegExp('<' + tag + '><!\\\\[CDATA\\\\[([\\\\s\\\\S]*?)\\\\]\\\\]></' + tag + '>'));\n  if (m) return m[1];\n  const m2 = xml.match(new RegExp('<' + tag + '>([\\\\s\\\\S]*?)</' + tag + '>'));\n  return m2 ? m2[1] : '';\n}\nreturn [{ to: get('ToUserName'), from: get('FromUserName'), msgType: get('MsgType'), content: get('Content') }];"
      },
      "id": "00000000-0000-4000-8000-000000000607",
      "name": "Parse WeChat XML",
