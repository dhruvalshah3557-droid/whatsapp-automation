      "id": "00000000-0000-4000-8000-000000000608",
      "name": "Is text message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst xml =\n  '<xml>' +\n  '<ToUserName><![CDATA[' + item.from + ']]></ToUserName>' +\n  '<FromUserName><![CDATA[' + item.to + ']]></FromUserName>' +\n  '<CreateTime>' + Math.floor(Date.now() / 1000) + '</CreateTime>' +\n  '<MsgType><![CDATA[text]]></MsgType>' +\n  '<Content><![CDATA[Thanks for your WeChat message!]]></Content>' +\n  '</xml>';\nreturn [{ body: xml }];"
      },
