    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst q = $input.first().json.query;\nconst token = 'change_me_wechat_token';\nconst arr = [token, q.timestamp, q.nonce].sort();\nconst sig = crypto.createHash('sha1').update(arr.join('')).digest('hex');\nreturn [{ valid: sig === q.signature, echostr: q.echostr }];"
      },
      "id": "00000000-0000-4000-8000-000000000602",
